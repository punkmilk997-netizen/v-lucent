# Local companion proxy (proxy-server.cjs) — copy values into your shell env.
# Do not commit real tokens.
#
# ROTATION (P1 scrub): an old gateway token was previously hardcoded in
# proxy-server.cjs (git history commit 18d3b1f removed it). If that token was
# ever the live Lilith/OpenClaw gateway credential, rotate it on the VPS/Lilith
# side, then set the NEW value only in local env (never in source):
#   PowerShell:  $env:GATEWAY_TOKEN="..."
#   Or a private .env file that is gitignored (not committed).

OPENCLAW_URL=http://127.0.0.1:3031
GATEWAY_TOKEN=
PROXY_PORT=3032
